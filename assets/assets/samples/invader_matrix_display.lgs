r = 1;\n  state_phase = 0;\n  x_counter = 0;\n  y_counter = 0;\n  Write = 0;\n} else {\n  Clear = 0;\n\n  if (state_phase == 0) {\n    # Phase 0: Setup data\n    Write = 0;\n    state_phase = 1;\n  } else {\n    # Phase 1: Write pixel and increment counter\n    Write = 1;\n    state_phase = 0;\n\n    var next_x = x_counter + 1;\n\n    if (x_counter == 63) {\n      x_counter = 0;\n\n      if (y_counter == 63) {\n        y_counter = 0;\n      } else {\n        y_counter = y_counter + 1;\n      }\n    } else {\n      x_counter = next_x;\n    }\n  }\n}"}},{"id":"PZ9WC51N5QU3DXHS8P10ZOT4CEZMSH","type":"Clock","position":{"dx":70.0,"dy":80.0},"properties":{"clockConfig":{"frequency":60,"dutyCycle":0.5,"initialState":false}}},{"id":"WEBQNITZPS66HMYNTJ93VTX1RR9EMK","type":"Input","position":{"dx":20.0,"dy":200.0},"properties":{"isOn":true}},{"id":"WFWTS57DSDZVFYN87RL6NZJB107N57","type":"NotGate","position":{"dx":155.0,"dy":200.0},"properties":{}},{"id":"QPJSWYSI873ZDUPXUD4ITO9FXIEMV8","type":"MatrixDisplay32x32","position":{"dx":630.0,"dy":320.0},"properties":{"pixelBuffer":[[false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false],[false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false],[false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false],[false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false],[false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,f