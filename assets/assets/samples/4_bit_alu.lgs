{"components":[{"id":"X3WAKIE1WT8OKWOH8CX95TZMPBO4KI","type":"CustomComponent","position":{"dx":360.0,"dy":535.0},"properties":{"customName":"4-bit ALU","script":"inputs: A[4], B[4], Op[2]\r\noutputs: Y[4], Overflow, Negative\r\n\r\nvar val = 0;\r\n\r\nif (Op == 0) {\r\n  val = A + B;\r\n  Overflow = val > 15;\r\n  Negative = 0;\r\n} else if (Op == 1) {\r\n  val = A - B;\r\n  Overflow = 0;\r\n  Negative = val < 0;\r\n} else if (Op == 2) {\r\n  val = A * B;\r\n  Overflow = val > 15;\r\n  Negative = 0;\r\n} else {\r\n  if (B == 0) {\r\n    val = 0;\r\n    Overflow = 1;\r\n  } else {\r\n    val = A / B;\r\n    Overflow = 0;\r\n  }\r\n  Negative = 0;\r\n}\r\n\r\nY = val;\r\n"}},{"id":"1FMSTQHB8A8O4HW1T4I2U11I12S54B","type":"Input","position":{"dx":85.0,"dy":20.0},"properties":{"isOn":true}},{"id":"DUMBI6SDWB7LB6R93QSI5F3R5IXUVT","type":"Input","position":{"dx":85.0,"dy":85.0},"properties":{"isOn":false}},{"id":"6N983ZWQZ4KP4652ZD1HJOX5GVBOYZ","type":"Input","position":{"dx":85.0,"dy":150.0},"properties":{"isOn":true}},{"id":"ZV8CVT6UIQPO0Y5TJOAOQD2KCSS0TP","type":"Input","position":{"dx":85.0,"dy":215.0},"properties":{"isOn":false}},{"id":"YNERPNX89ULK3GWM34G98QN5OS8P81","type":"Input","position":{"dx":85.0,"dy":305.0},"properties":{"isOn":true}},{"id":"YR5AV2CHKATF8Q0C11NZ170KX6F1PB","type":"Input","position":{"dx":85.0,"dy":370.0},"properties":{"isOn":true}},{"id":"GV4Y77UM5SHBXUB6CPM974JA18VNJN","type":"Input","position":{"dx":85.0,"dy":435.0},"properties":{"isOn":false}},{"id":"SPPGE28TFZTOFA4LCL0CJDF29R066P","type":"Input","position":{"dx":85.0,"dy":500.0},"properties":{"isOn":false}},{"id":"1H4XCFUTAHQKBCPKLS5ZZY0D0KEUJD","type":"Input","position":{"dx":575.0,"dy":845.0},"properties":{"isOn":true}},{"id":"74BYBIWIJQ1IHMHAQ1V58E872Q5H5J","type":"Input","position":{"dx":85.0,"dy":650.0},"properties":{"isOn":true}},{"id":"ZKLNEDFS6JI8P3E9VMGSFNYBFCBBRM","type":"Input","position":{"dx":85.0,"dy":725.0},"properties":{"isOn":false}},{"id":"9BJ5C9XRZQHORM9XZITA6AUWVK98FT