{"components":[{"id":"LFY7PA4MLIFACF6FVCUMOIRKQFC1VC","type":"KeyboardInput","position":{"dx":100.0,"dy":185.0},"properties":{}},{"id":"JBX6ZJ0W1336204QH3ZDXTZRE1Q44G","type":"CharacterLCD4x16","position":{"dx":540.0,"dy":20.0},"properties":{}},{"id":"RPCCYQGC9234ST3IN2NNO240CIWM6R","type":"Input","position":{"dx":20.0,"dy":380.0},"properties":{"isOn":true}},{"id":"XHAACXJFPKZSA5K87TZG9GGXOTOVKG","type":"CustomSequentialComponent","position":{"dx":335.0,"dy":175.0},"properties":{"customName":"KEYBOARD DRIVER","script":"inputs: I[8], STR\noutputs: D[8], RS, EN\n\nvar dTemp = 0;\nvar rsTemp = 1;\n\n# Map ASCII/Key codes to LCI Commands\nif (I == 8) {\n  # Backspace -> Move Left\n  dTemp = 4;\n  rsTemp = 0;\n} else if (I == 13) {\n  # Enter -> Return Home\n  dTemp = 2;\n  rsTemp = 0;\n} else if (I == 27) {\n  # Escape -> Clear Iisplay\n  dTemp = 1;\n  rsTemp = 0;\n} else if (I == 28) {\n  # Left Arrow -> Move Left\n  dTemp = 4;\n  rsTemp = 0;\n} else if (I == 29) {\n  # Right Arrow -> Move Right\n  dTemp = 3;\n  rsTemp = 0;\n} else {\n  # Filter other control characters\n  if (I < 32) {\n    dTemp = 0;\n    rsTemp = 0;\n  } else {\n    dTemp = I;\n    rsTemp = 1;\n  }\n}\n\nD = dTemp;\nRS = rsTemp;\nEN = STR;"}}],"wires":[{"startComponentId":"LFY7PA4MLIFACF6FVCUMOIRKQFC1VC","startPinIndex":0,"startPinType":1,"endComponentId":"XHAACXJFPKZSA5K87TZG9GGXOTOVKG","endPinIndex":0,"endPinType":0,"segments":[{"dx":292.5,"dy":220.0}]},{"startComponentId":"LFY7PA4MLIFACF6FVCUMOIRKQFC1VC","startPinIndex":1,"startPinType":1,"endComponentId":"XHAACXJFPKZSA5K87TZG9GGXOTOVKG","endPinIndex":1,"endPinType":0,"segments":[{"dx":292.5,"dy":235.0}]},{"startComponentId":"LFY7PA4MLIFACF6FVCUMOIRKQFC1VC","startPinIndex":2,"startPinType":1,"endComponentId":"XHAACXJFPKZSA5K87TZG9GGXOTOVKG","endPinIndex":2,"endPinType":0,"segments":[{"dx":292.5,"dy":250.0}]},{"startComponentId":"LFY7PA4MLIFACF6FVCUMOIRKQFC1VC","startPinIndex":3,"startPinType":1,"endComponentId":"XHAACXJFPKZSA5K87TZG9GGXOTOVKG","e