{"components":[{"id":1,"type":"CustomSequentialComponent","position":{"dx":675.0,"dy":125.0},"properties":{"script":"clock: CLK\ninputs: R[4]\noutputs: D[8], C[4]\nstate: lastKey[8], keyPressed, scanState[2], timeout[3]\n\n# One-hot encoding for column outputs\nif (scanState == 0) C = 1;      # Col 0 active\nelse if (scanState == 1) C = 2; # Col 1 active\nelse if (scanState == 2) C = 4; # Col 2 active\nelse if (scanState == 3) C = 8; # Col 3 active\nelse C = 0;\n\nanyKey = (R != 0);\n\nif (anyKey) timeout = 5;\nelse if (timeout > 0) timeout = timeout - 1;\n\nif (timeout == 0) lastKey = 0;\n\n# Output stored key\nD = lastKey;\n\n# Capture value on rising edge of key press\nif (anyKey && !keyPressed) {\n   if (scanState == 0) { # Column 0\n      if (R[0]) lastKey = 49; # '1'\n      else if (R[1]) lastKey = 52; # '4'\n      else if (R[2]) lastKey = 55; # '7'\n      else if (R[3]) lastKey = 42; # '*'\n      else lastKey = 0;\n   }\n   else if (scanState == 1) { # Column 1\n      if (R[0]) lastKey = 50; # '2'\n      else if (R[1]) lastKey = 53; # '5'\n      else if (R[2]) lastKey = 56; # '8'\n      else if (R[3]) lastKey = 48; # '0'\n      else lastKey = 0;\n   }\n   else if (scanState == 2) { # Column 2\n      if (R[0]) lastKey = 51; # '3'\n      else if (R[1]) lastKey = 54; # '6'\n      else if (R[2]) lastKey = 57; # '9'\n      else if (R[3]) lastKey = 35; # '#'\n      else lastKey = 0;\n   }\n   else if (scanState == 3) { # Column 3\n      if (R[0]) lastKey = 65; # 'A'\n      else if (R[1]) lastKey = 66; # 'B'\n      else if (R[2]) lastKey = 67; # 'C'\n      else if (R[3]) lastKey = 68; # 'D'\n      else lastKey = 0; \n   }\n}\n\nkeyPressed = anyKey;\n\n# Cycle through columns 0->1->2->3->0\nscanState = (scanState + 1) % 4;\n","customName":"KEYPAD INTERFACE"}},{"id":2,"type":"Keypad4x4","position":{"dx":675.0,"dy":410.0},"properties":{}},{"id":3,"type":"Clock","position":{"dx":365.0,"dy":650.0},"properties":{"clockConfig":{"frequency":30,"dutyCycle":0.5,"initialState"