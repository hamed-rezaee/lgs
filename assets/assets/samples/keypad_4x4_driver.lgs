{"components":[{"id":"SLUZEZNN62MSIXDFS548IYI8MN7R65","type":"CustomSequentialComponent","position":{"dx":300.0,"dy":150.0},"properties":{"customName":"KEYPAD 4x4 INTERFACE","script":"clock: CLK\ninputs: R[4]\noutputs: D[8], C[4], V\nstate: lastKey[8], keyPressed, scanState[2], timeout[3], valid\nvars: anyKey\n\n# One-hot encoding for column outputs\nif (scanState == 0) C = 1;      # Col 0 active\nelse if (scanState == 1) C = 2; # Col 1 active\nelse if (scanState == 2) C = 4; # Col 2 active\nelse if (scanState == 3) C = 8; # Col 3 active\nelse C = 0;\n\nanyKey = (R != 0);\n\nV = valid;\nvalid = 0;\nif (timeout == 0 && anyKey) valid = 1;\n\nif (anyKey) timeout = 5;\nelse if (timeout > 0) timeout = timeout - 1;\n\nif (timeout == 0) lastKey = 0;\n\n# Output stored key\nD = lastKey;\n\n# Capture value on rising edge of key press\nif (anyKey && !keyPressed) {\n   if (scanState == 0) { # Column 0\n      if (R[0]) lastKey = 49; # '1'\n      else if (R[1]) lastKey = 52; # '4'\n      else if (R[2]) lastKey = 55; # '7'\n      else if (R[3]) lastKey = 42; # '*'\n      else lastKey = 0;\n   }\n   else if (scanState == 1) { # Column 1\n      if (R[0]) lastKey = 50; # '2'\n      else if (R[1]) lastKey = 53; # '5'\n      else if (R[2]) lastKey = 56; # '8'\n      else if (R[3]) lastKey = 48; # '0'\n      else lastKey = 0;\n   }\n   else if (scanState == 2) { # Column 2\n      if (R[0]) lastKey = 51; # '3'\n      else if (R[1]) lastKey = 54; # '6'\n      else if (R[2]) lastKey = 57; # '9'\n      else if (R[3]) lastKey = 35; # '#'\n      else lastKey = 0;\n   }\n   else if (scanState == 3) { # Column 3\n      if (R[0]) lastKey = 65; # 'A'\n      else if (R[1]) lastKey = 66; # 'B'\n      else if (R[2]) lastKey = 67; # 'C'\n      else if (R[3]) lastKey = 68; # 'D'\n      else lastKey = 0; \n   }\n}\n\nkeyPressed = anyKey;\n\n# Cycle through columns 0->1->2->3->0\nscanState = (scanState + 1) % 4;\n"}},{"id":"327XTAZI0RSKQCHBFBBFT1J4E0AH7Z","type":"Keypad4x4","position":{"dx":315.0,"dy":